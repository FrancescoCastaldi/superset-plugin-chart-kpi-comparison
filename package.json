{
  "name": "superset-plugin-chart-kpi-comparison",
  "version": "0.1.26",
  "description": "KPI Comparison Card — All-in-One KPI Card with Temporal & Dual Metric Delta % for Apache Superset",
  "homepage": "https://github.com/FrancescoCastaldi/superset-plugin-chart-kpi-comparison",
  "repository": {
    "type": "git",
    "url": "https://github.com/FrancescoCastaldi/superset-plugin-chart-kpi-comparison.git"
  },
  "main": "dist/index.esm.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "(tsc --project tsconfig.json --emitDeclarationOnly || node node_modules/typescript/lib/tsc.js --project tsconfig.json --emitDeclarationOnly || npx tsc --project tsconfig.json --emitDeclarationOnly) && npm run build:esm",
    "build:esm": "node scripts/build.mjs",
    "clean": "rimraf dist",
    "test": "node ./node_modules/jest/bin/jest.js --preset=ts-jest || node ../../node_modules/jest/bin/jest.js --preset=ts-jest",
    "test:watch": "node ./node_modules/jest/bin/jest.js --preset=ts-jest --watch || node ../../node_modules/jest/bin/jest.js --preset=ts-jest --watch",
    "install:plugin": "powershell -ExecutionPolicy Bypass -File ./install-plugin.ps1"
  },
  "keywords": [
    "superset",
    "apache-superset",
    "superset-plugin",
    "superset-chart",
    "kpi",
    "kpi-comparison",
    "delta-percentage",
    "card",
    "healthcare",
    "dashboard"
  ],
  "author": "Francesco Castaldi",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@superset-ui/chart-controls": "*",
    "@superset-ui/core": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@superset-ui/chart-controls": "^0.20.3",
    "@superset-ui/core": "^0.20.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^16.18.126",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "esbuild": "^0.25.12",
    "jest": "^29.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-jest": "^29.1.2",
    "typescript": "~5.9.2"
  }
}
